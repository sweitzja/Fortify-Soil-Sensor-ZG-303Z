+	af_endpointRegister(SENSOR_DEVICE_ENDPOINT, (af_simple_descriptor_t *)&sensorDevice_simpleDesc, zcl_rx_handler, sensorDevice_dataCnfCb);
 #if (DEV_SERVICES & SERVICE_PLM)
