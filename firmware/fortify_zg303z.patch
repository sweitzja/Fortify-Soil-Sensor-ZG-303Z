+#endif
+#ifdef ZCL_THERMOSTAT_UI_CFG
+    reportableChange = 1; // TX power current (dBm): report on any change
+	bdb_defaultReportingCfg(
+		SENSOR_DEVICE_ENDPOINT,
+		HA_PROFILE_ID,
+		ZCL_CLUSTER_HAVC_USER_INTERFACE_CONFIG,
+		0x0124,
